<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31) launch surface — the splash screen only, never the app.

    The system splash composes two layers: an animated icon (the app icon, by default) over
    `android:windowSplashScreenBackground`. Painting that background with the adaptive icon's own
    background token (`@color/ic_launcher_background` → `@color/brand_blue`, the artwork's ground)
    makes the icon's square bleed into the screen, so the launch reads as one blue surface with
    the illustration on it — no visible icon plate, no white flash mid-launch.

    Deliberately NOT `android:windowBackground`: that one is the app window behind the first
    Compose frame and must stay the editor canvas (see `values/themes.xml`, `Theme.Foglietto.Base`).
    The splash is the only thing this qualifier re-skins.

    Scope: this file only overrides the qualified style for API 31+; the base items still come
    from `Theme.Foglietto.Base` through the parent, which is why the style is split in two.
-->
<resources>

    <style name="Theme.Foglietto" parent="Theme.Foglietto.Base">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
    </style>

</resources>
