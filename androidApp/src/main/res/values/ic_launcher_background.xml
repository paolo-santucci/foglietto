<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon — background layer (TASK-12, FR-41 / OQ-05).

    An alias for the launcher artwork's ground in `res/values/colors.xml` (S11): the icon, the
    Android 12+ splash and the artwork now name one colour, so they cannot drift apart. The fill is
    `brand_blue` (#296FB3) — the full-bleed field inside the launcher vector — not the branding
    yellow: the 2026-11 artwork replaced the yellow plate, and the splash follows the icon by
    reference (`values-v31/themes.xml`).

    The value is scheme-independent on purpose: the icon ships one background layer, so the splash
    must match it in dark mode too.
-->
<resources>
    <color name="ic_launcher_background">@color/brand_blue</color>
</resources>
